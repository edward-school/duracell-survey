# REQUIRED: facilitator password for /host (choose something long)
HOST_PASSWORD=change-me-to-a-long-password
# REQUIRED in production
NODE_ENV=production
# Where the SQLite database lives. On Railway/Render/Fly point this at the mounted persistent volume.
DATA_DIR=/data
# OPTIONAL: public address used in the QR code (otherwise taken from the request)
# PUBLIC_URL=https://duracell-survey.up.railway.app
# OPTIONAL: enables AI theme suggestions for written answers. Leave unset to use keyword/manual grouping only.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPTIONAL: stable secret for hashing anonymous browser ids (auto-generated and stored in the DB if unset)
# SERVER_SECRET=
